#!/bin/sh
# Exécuté dans le système de la clé pendant sa construction.
set -e
chmod 755 /usr/local/bin/terrapilote /usr/local/bin/terrapilote-web /usr/local/bin/terrapilote-kiosk
systemctl enable terrapilote-web.service systemd-networkd.service systemd-resolved.service
mkdir -p /srv/terrapilote/images
echo terrapilote > /etc/hostname
