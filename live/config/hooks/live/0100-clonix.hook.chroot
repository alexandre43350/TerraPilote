#!/bin/sh
# Exécuté dans le système de la clé pendant sa construction.
set -e
chmod 755 /usr/local/bin/clonix /usr/local/bin/clonix-web /usr/local/bin/clonix-kiosk
systemctl enable clonix-web.service systemd-networkd.service systemd-resolved.service
mkdir -p /srv/clonix/images
echo clonix > /etc/hostname
