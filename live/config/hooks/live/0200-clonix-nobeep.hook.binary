#!/bin/sh
# Exécuté sur l'arborescence finale de l'ISO, juste avant sa création.
# Pas de son au menu de démarrage : les menus Debian jouent une petite mélodie
# (accessibilité) avec la commande GRUB « play », et certains menus syslinux
# contiennent le caractère « cloche » (^G). On les retire de tous les fichiers
# de configuration des menus, quel que soit l'outil qui les a produits.
set -e
find . -type f -name '*.cfg' | while IFS= read -r f; do
    sed -i \
        -e '/^[[:space:]]*play[[:space:]]/d' \
        -e '/^[[:space:]]*insmod[[:space:]][[:space:]]*play[[:space:]]*$/d' \
        -e 's/\x07//g' \
        "$f"
done
