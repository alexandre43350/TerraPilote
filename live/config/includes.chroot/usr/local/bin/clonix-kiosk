#!/bin/sh
# Affiche l'interface en plein écran. Code de sortie non nul = pas d'affichage
# graphique possible (le menu texte prend le relais).
#
# cage refuse de tourner en root. On lance donc l'affichage sous le compte sans
# privilèges « kiosk » ; seatd lui donne accès à l'écran, au clavier et à la
# souris. Le navigateur ne fait qu'afficher http://127.0.0.1:8470/ ; tout le
# travail sur les disques est fait en root par clonix-web.service.
set -e

URL=http://127.0.0.1:8470/
i=0
until wget -q -O /dev/null "$URL" 2>/dev/null || [ "$i" -ge 30 ]; do
    i=$((i + 1)); sleep 0.5
done

RT=/run/kiosk
install -d -m 700 -o kiosk -g kiosk "$RT"

exec runuser -u kiosk -- env \
    HOME=/home/kiosk \
    XDG_RUNTIME_DIR="$RT" \
    XDG_SESSION_TYPE=wayland \
    LIBSEAT_BACKEND=seatd \
    MOZ_ENABLE_WAYLAND=1 \
    MOZ_DBUS_REMOTE=1 \
    cage -- firefox-esr --kiosk --private-window "$URL"
