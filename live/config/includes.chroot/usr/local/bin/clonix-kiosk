#!/bin/sh
# Affiche l'interface en plein écran. Code de sortie non nul = pas d'affichage
# graphique possible (le menu texte prend le relais).
#
# Lancé par le compte « kiosk » (connexion automatique), qui dispose d'une
# session logind donnant accès à l'écran et au clavier. Le navigateur ne fait
# qu'afficher http://127.0.0.1:8470/ ; tout le travail sur les disques est fait
# en root par clonix-web.service.
set -e

URL=http://127.0.0.1:8470/
i=0
until wget -q -O /dev/null "$URL" 2>/dev/null || [ "$i" -ge 30 ]; do
    i=$((i + 1)); sleep 0.5
done

# Dossier d'exécution (normalement fourni par logind) ; filet de sécurité.
: "${XDG_RUNTIME_DIR:=/run/user/$(id -u)}"
export XDG_RUNTIME_DIR
[ -d "$XDG_RUNTIME_DIR" ] || install -d -m 700 "$XDG_RUNTIME_DIR"

# Clavier : sans réglage, l'écran graphique (cage) utilise le clavier américain
# (QWERTY). On reprend la disposition de la console, fixée au démarrage par le
# paramètre keyboard-layouts (fr par défaut).
if [ -r /etc/default/keyboard ]; then
    . /etc/default/keyboard
fi
export XKB_DEFAULT_LAYOUT="${XKBLAYOUT:-fr}"
export XKB_DEFAULT_MODEL="${XKBMODEL:-pc105}"
[ -n "${XKBVARIANT:-}" ] && export XKB_DEFAULT_VARIANT="$XKBVARIANT"
[ -n "${XKBOPTIONS:-}" ] && export XKB_DEFAULT_OPTIONS="$XKBOPTIONS"

# Rendu logiciel (pixman + llvmpipe) : Clonix doit démarrer sur n'importe quel
# PC, y compris ceux dont le pilote graphique accéléré n'est pas disponible.
# Une page web se dessine très bien sans accélération matérielle.
export WLR_RENDERER=pixman
export WLR_NO_HARDWARE_CURSORS=1
export LIBGL_ALWAYS_SOFTWARE=1
export MOZ_ENABLE_WAYLAND=1
export MOZ_DBUS_REMOTE=1

exec cage -- firefox-esr --kiosk --private-window "$URL"
